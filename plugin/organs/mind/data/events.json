{
  "version": 1,
  "_doc": "核的识别规则：五类事件（与心的 model.EVENTS 同一份枚举）的词表、阈值、问句规则、场景开关全在这里，代码里一个中文词都不写。改这里就改行为。",
  "punct": " \t\r\n　~～`!！?？.。,，、;；:：'\"“”‘’()（）[]【】{}《》<>…—-＿_·*#@&+=|/\\",
  "clause_seps": "。！？；，,;!?~～\n",
  "priority": [
    "insult",
    "rejected",
    "cold",
    "praise",
    "care"
  ],
  "scenes": {
    "praise": [
      "group",
      "private"
    ],
    "care": [
      "private"
    ],
    "cold": [
      "group",
      "private"
    ],
    "insult": [
      "group",
      "private"
    ],
    "rejected": [
      "group",
      "private"
    ]
  },
  "kinds": {
    "praise": {
      "rule": "words",
      "words": [
        "厉害",
        "真好",
        "真棒",
        "优秀",
        "聪明",
        "喜欢你",
        "佩服",
        "了不起",
        "太好了",
        "辛苦了",
        "谢谢",
        "多亏你"
      ],
      "note": "夸：词表命中 {words}"
    },
    "care": {
      "rule": "words",
      "words": [
        "吃饭",
        "吃了吗",
        "饿不饿",
        "累不累",
        "早点睡",
        "多穿",
        "喝水",
        "注意身体",
        "休息",
        "还好吗",
        "怎么了",
        "别累着",
        "感冒",
        "生病",
        "保重",
        "照顾你"
      ],
      "note": "关心：词表命中 {words}"
    },
    "cold": {
      "rule": "window",
      "window": 3,
      "max_len": 3,
      "words": [
        "嗯",
        "哦",
        "好",
        "嗯嗯",
        "哦哦",
        "好吧",
        "好的",
        "行",
        "是"
      ],
      "note": "冷落：最近 {n} 轮她的回话都是极短应答（{replies}）"
    },
    "insult": {
      "rule": "words",
      "words": [
        "傻逼",
        "傻b",
        "滚开",
        "滚吧",
        "滚蛋",
        "滚出去",
        "废物",
        "蠢",
        "笨",
        "白痴",
        "恶心",
        "闭嘴",
        "去死",
        "垃圾",
        "没用",
        "有病",
        "烦死",
        "讨厌你",
        "神经病"
      ],
      "note": "被骂：词表命中 {words}"
    },
    "rejected": {
      "rule": "refusal",
      "refuse": [
        "不要",
        "不用",
        "算了",
        "别了",
        "不必",
        "拒绝",
        "没兴趣",
        "不行",
        "免了",
        "下次吧",
        "不想",
        "不了"
      ],
      "offer": [
        "？",
        "?",
        "吗",
        "要不要",
        "帮你",
        "用不用",
        "好不好",
        "想不想",
        "一起",
        "需要我",
        "给你"
      ],
      "note": "被拒绝：这一轮出现 {refuse}，而她上一轮在问 {offer}"
    }
  }
}
