{
  "context": { "maxMessages": 8, "maxChars": 4000, "maxAgeMs": 300000 },
  "batch": {
    "quietGapMs": 30000,
    "openMs": {
      "quietOpen": 2000,
      "activeOpen": 5000,
      "privateOpen": 3500
    },
    "continueMs": {
      "group": 3000,
      "private": 3500
    },
    "hardCapMs": 8000,
    "maxMsgs": 6,
    "mentionCapMs": 1000,
    "bareImageMs": 4000,
    "stickerMs": 500
  },
  "outbound": {
    "maxChars": 512,
    "maxSentences": 8,
    "maxChunks": 3,
    "newlineGapMs": 800,
    "maxCharsPerBubble": 60,
    "bubbleSentenceMarks": ["。", "！", "？", "…", "；"],
    "bubbleClauseMarks": ["，", "、", "；", ","],
    "bubbleTailParticles": ["啊", "吧", "呢", "嘛", "呀", "哦", "啦", "咯", "喽", "呗", "噢"],
    "commaSplitRatePct": 25,
    "commaSplitMarks": ["，", ","],
    "defaultReplies": [
      "嗯，我在。",
      "……我在听。",
      "这句我想说的太长，先简短回一句：我在。"
    ]
  },
  "quota": {
    "windowMs": 3600000,
    "perGroupMax": 6,
    "mentionCanExceed": false
  },
  "decide": {
    "reasonCodes": [
      "sent",
      "silent_mode",
      "quota_exceeded",
      "core_error",
      "outbound_failed",
      "core_empty",
      "replaced_too_long",
      "command",
      "sticker",
      "media_only",
      "burst_guard",
      "chitchat_skipped",
      "superseded"
    ]
  }
}
